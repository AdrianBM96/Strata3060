+// ---- P08 (prototipo): gu_rows IQ2_S nt=1 intercalado a 2 filas.
+//
+// El bucle fila-a-fila deja un solo acumulador madd vivo por mitad y relee y
+// desde el inicio en cada fila. Procesar el par (r, r+1) con UNA carga de y
+// por mitad alimenta dos cadenas madd independientes (los 2 puertos FMA) y
+// lee y la mitad de veces. El orden de acumulacion entera y flotante por fila
+// es el de row_dot_iq2s<1>: bit-identico. Solo camino nt=1 de IQ2_S (22);
+// el resto de tipos/anchos no cambia. STRATA_P08=0 = camino viejo.
+inline bool p08_on() {
+    const char* v = std::getenv("STRATA_P08");
+    return v == nullptr || v[0] != '0';
+}
