+/// **`--logprobs N`: SYSTEM ONE / JEV OVER THE PROMPT'S LAST POSITION.**
+///
+/// Print the N most likely next tokens and their log-softmax, so a caller can score a
+/// FINITE set of options (a, b, c... the letters of a choice question) in one forward
+/// pass instead of generating JSON and validating it.  Absolute logprobs (log-softmax
+/// over the whole vocabulary, temperature 1): the caller applies its own temperature and
+/// normalizes over its own options.  Token IDs, not text - this build has no tokenizer,
+/// the server decodes them.  Pure read-out: it never draws, commits or touches the
+/// sampler or the KV state, so normal generation is byte-for-byte unaffected.
+void emit_logprobs_line(const float* row, int64_t n_vocab, int k) {
+    if (k <= 0 || row == nullptr || n_vocab <= 0) return;
+    double mx = -1e30;
+    for (int64_t i = 0; i < n_vocab; ++i) if ((double) row[i] > mx) mx = (double) row[i];
+    double se = 0.0;
+    for (int64_t i = 0; i < n_vocab; ++i) se += std::exp((double) row[i] - mx);
+    const double lse = mx + std::log(se);
+    if (k > n_vocab) k = (int) n_vocab;
+    std::vector<int> idx((size_t) n_vocab);
+    for (int64_t i = 0; i < n_vocab; ++i) idx[(size_t) i] = (int) i;
+    std::partial_sort(idx.begin(), idx.begin() + k, idx.end(),
+                      [&](int a, int b) { return row[a] > row[b]; });
+    std::printf("strata logprobs:");
+    for (int i = 0; i < k; ++i) std::printf(" %d:%.6f", idx[(size_t) i], (double) row[idx[(size_t) i]] - lse);
+    std::printf("\n");
+    std::fflush(stdout);
+}
+
+/// **`lpids=a,b,c` (una clave por peticion, `--serve`).**  La misma fila, pero en vez
+/// del top-k imprime EXACTAMENTE esos ids.  Hace falta para System One: si la letra de
+/// una opcion no cae en el top-k, normalizar sobre las encontradas la trata como 0 y
+/// deforma la distribucion.  Con los ids exactos de las opciones no puede faltar
+/// ninguna.  Desconocida para un motor viejo (las claves se saltan), asi que es
+/// compatible hacia atras.
+void emit_logprobs_ids(const float* row, int64_t n_vocab, const std::vector<int>& ids) {
+    if (row == nullptr || n_vocab <= 0 || ids.empty()) return;
+    double mx = -1e30;
+    for (int64_t i = 0; i < n_vocab; ++i) if ((double) row[i] > mx) mx = (double) row[i];
+    double se = 0.0;
+    for (int64_t i = 0; i < n_vocab; ++i) se += std::exp((double) row[i] - mx);
+    const double lse = mx + std::log(se);
+    std::printf("strata logprobs:");
+    for (int id : ids)
+        if (id >= 0 && (int64_t) id < n_vocab) std::printf(" %d:%.6f", id, (double) row[id] - lse);
+    std::printf("\n");
+    std::fflush(stdout);
+}
