diff --git a/src/prefill/layer_major.cpp b/src/prefill/layer_major.cpp
new file mode 100644
index 0000000..f223702
--- /dev/null
+++ b/src/prefill/layer_major.cpp
@@ -0,0 +1,120 @@
+// src/prefill/layer_major.cpp - C28 superblock planner (pure CPU, no CUDA).
+#include "strata/prefill/layer_major.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+#include <vector>
+
+namespace strata::prefill::layer_major {
+
+std::vector<Superblock> plan_superblocks(int64_t n, int64_t pos0, int64_t chunk_T,
+                                         int64_t max_sb_tokens, int64_t next_ckpt_abs,
+                                         int64_t every) {
+    std::vector<Superblock> out;
+    if (n <= 0 || chunk_T <= 0) return out;
+    const int64_t nchunks = (n + chunk_T - 1) / chunk_T;
+    // Chunk end i (i = 1..nchunks, exclusive chunk count): absolute position.
+    auto end_of = [&](int64_t i) { return pos0 + std::min(i * chunk_T, n); };
+    // Periodic firing chunk-ends, simulated like generate.cpp:5456-5473:
+    // fire at the first chunk end >= pending, then pending = fired + every.
+    std::vector<int64_t> bounds;  // exclusive chunk counts
+    if (every > 0 && next_ckpt_abs >= 0 && next_ckpt_abs != std::numeric_limits<int64_t>::max()) {
+        int64_t pending = next_ckpt_abs;
+        for (int64_t guard = 0; guard <= nchunks + 1; ++guard) {
+            int64_t hit = -1;
+            for (int64_t i = 1; i <= nchunks; ++i) {
+                if (end_of(i) >= pending) { hit = i; break; }
+            }
+            if (hit < 0) break;
+            bounds.push_back(hit);
+            pending = end_of(hit) + every;
+        }
+    }
+    const int64_t cap_chunks =
+        max_sb_tokens > 0 ? std::max<int64_t>(1, max_sb_tokens / chunk_T) : nchunks;
+    int64_t start = 0;
+    size_t bi = 0;
+    while (start < nchunks) {
+        int64_t end = std::min(start + cap_chunks, nchunks);
+        while (bi < bounds.size() && bounds[bi] <= start) ++bi;
+        if (bi < bounds.size()) end = std::min(end, bounds[bi]);
+        if (end <= start) end = start + 1;  // defensive: never stall
+        if (end > nchunks) end = nchunks;
+        out.push_back({start, end});
+        start = end;
+    }
+    return out;
+}
+
+bool enabled() {
+    const char* v = std::getenv("STRATA_PREFILL_LAYER_MAJOR");
+    return v != nullptr && v[0] == '1';
+}
+
+int64_t max_sb_tokens() {
+    const char* v = std::getenv("STRATA_PREFILL_LM_MAX_TOKENS");
+    if (v != nullptr && std::atoll(v) > 0) return (int64_t) std::atoll(v);
+    return 32768;
+}
+
+SpillPlan spill_plan(int64_t n, bool with_lo) {
+    SpillPlan p;
+    if (n <= 0) return p;
+    p.tokens = n;
+    p.r_bytes = (uint64_t) n * (uint64_t) kHyperDim * 4u;
+    p.grs_bytes = (uint64_t) n * 4u * 4u;  // HC = 4 floats/token
+    p.xn16_bytes = (uint64_t) n * (uint64_t) kHyperDim * 2u;
+    p.lo_bytes = with_lo ? (uint64_t) n * (uint64_t) kHyperDim * 2u : 0u;
+    p.total_bytes = p.r_bytes + p.grs_bytes + p.xn16_bytes + p.lo_bytes;
+    return p;
+}
+
+std::vector<int64_t> nonresident_per_layer(const int32_t* host_res, int64_t n_layers,
+                                           int64_t n_expert, int64_t lb, int64_t le) {
+    std::vector<int64_t> out;
+    if (n_layers <= 0 || n_expert <= 0) return out;
+    if (lb < 0) lb = 0;
+    if (le > n_layers) le = n_layers;
+    for (int64_t l = lb; l < le; ++l) {
+        int64_t e_nr = n_expert;  // no table: nothing resident
+        if (host_res != nullptr) {
+            e_nr = 0;
+            for (int64_t e = 0; e < n_expert; ++e)
+                if (host_res[l * n_expert + e] < 0) ++e_nr;
+        }
+        out.push_back(e_nr);
+    }
+    return out;
+}
+
+// ---- C28p: préstamo (CPU puro) ----
+
+int64_t wave_layers() {
+    const char* v = std::getenv("STRATA_PREFILL_LM_WAVE_LAYERS");
+    if (v != nullptr) {
+        const int64_t w = (int64_t) std::atoll(v);
+        if (w >= 1 && w <= 48) return w;
+    }
+    return 6;
+}
+
+uint64_t loan_bytes_for_spill(int64_t n, bool with_lo) {
+    return spill_plan(n, with_lo).total_bytes;
+}
+
+int64_t loan_slots_for_spill(int64_t n, bool with_lo, int64_t blob_bytes) {
+    if (n <= 0 || blob_bytes <= 0) return 0;
+    const uint64_t need = loan_bytes_for_spill(n, with_lo);
+    return (int64_t) ((need + (uint64_t) blob_bytes - 1u) / (uint64_t) blob_bytes);
+}
+
+std::vector<std::pair<int64_t, int64_t>> plan_waves(int64_t lb, int64_t le, int64_t wave_layers) {
+    std::vector<std::pair<int64_t, int64_t>> out;
+    if (le <= lb || wave_layers <= 0) return out;
+    for (int64_t w0 = lb; w0 < le; w0 += wave_layers) out.emplace_back(w0, std::min(w0 + wave_layers, le));
+    return out;
+}
+
+}  // namespace strata::prefill::layer_major
