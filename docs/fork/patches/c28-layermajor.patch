index 0000000..7acddaf
--- /dev/null
+++ b/include/strata/prefill/layer_major.hpp
@@ -0,0 +1,183 @@
+// include/strata/prefill/layer_major.hpp - C28: superblock partition rule.
+//
+// Pure-CPU planning for the layer-major prefill prototype: no CUDA, no model,
+// no GPU.  The engine executes fit-bounded chunks through its unchanged
+// chunk-major loop (each non-resident expert streams once per chunk, so one
+// chunk per superblock = once per superblock); this planner states the
+// superblock rule and PROVES its checkpoint parity: a superblock ends at
+// min(fits the staging budget, next checkpoint firing), firings simulated
+// EXACTLY like generate.cpp:5456-5473, so the deferred per-chunk reports of a
+// superblock only checkpoint at superblock ends - the same positions as the
+// chunk-major path, with the session state consistent.  The unit test covers
+// it without a GPU (including firing-set identity against chunk-major).
+//
+// Design (BRIEFING C28, docs/fork/exploracion/C28-ESTUDIO.md):
+//  1. A superblock is a run of consecutive chunks (one chunk per superblock
+//     when the whole superblock fits on the device: R stays in FP32 VRAM and
+//     no host spill is needed; the spill to pinned host RAM remains the
+//     fallback for prompts beyond the fit, with the loop interchange).
+//  2. A superblock ends at min(fits in the staging budget, next checkpoint
+//     firing).  Firings are simulated EXACTLY like generate.cpp:5456-5473:
+//     fire at the first chunk end >= pp_next_check, then pp_next = done+every.
+//     Intermediate chunk ends never reach pp_next, so checkpoints are only
+//     taken at superblock ends - the same positions as chunk-major.
+#pragma once
+
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace strata::prefill::layer_major {
+
+// The hyper-connected residual width: D = N*HC = 10240 floats/token, FP32
+// always (prefill.cpp:90,852).  R is bit-exact through the spill.
+inline constexpr int64_t kHyperDim = 10240;
+inline constexpr int64_t kHyperBytesPerToken = kHyperDim * 4;
+
+// A superblock: chunks [c0, c1) of the run (chunk indices, c1 exclusive).
+struct Superblock {
+    int64_t c0 = 0;
+    int64_t c1 = 0;
+};
+
+// Partition [0, n) (run starting at absolute position pos0, chunks of chunk_T
+// tokens) into superblocks.
+//   max_sb_tokens: staging fit cap (R spill budget); <= 0 = whole run.
+//   next_ckpt_abs: absolute pp_next_check (generate.cpp:6772); INT64_MAX or
+//     negative = no periodic checkpoint in range.
+//   every: prompt_cache_every; <= 0 = no periodic checkpoints.
+// A superblock end is always a chunk end; the last one is always n.
+std::vector<Superblock> plan_superblocks(int64_t n, int64_t pos0, int64_t chunk_T,
+                                         int64_t max_sb_tokens, int64_t next_ckpt_abs,
+                                         int64_t every);
+
+// FP32 bytes of the R spill of a superblock holding sb_tokens prompt tokens.
+inline int64_t r_spill_bytes(int64_t sb_tokens) { return sb_tokens * kHyperBytesPerToken; }
+
+// Tokens whose FP32 R (T*D*4) fits in lend_bytes - the borrowed expert-cache
+// bytes sizing this prompt's loan (generate.cpp: the tail slots lent by
+// plan_lend/lend, carved by Prefill::carve for R, the KV staging pool and the
+// streamed ring, refilled with experts after the prompt).  This is the
+// "cabe en huecos" side of the superblock cap; the caller takes
+// min(this, max_sb_tokens()), and plan_superblocks additionally cuts at the
+// next checkpoint firing, so the size is min(fit, checkpoint distance).
+// lend_bytes == 0 (own buffers, no loan): 0, meaning "no gap info" - the
+// planner then only cuts at checkpoint firings.
+inline int64_t fit_cap_tokens(uint64_t lend_bytes) {
+    if (lend_bytes == 0) return 0;
+    return (int64_t) (lend_bytes / ((uint64_t) kHyperBytesPerToken));
+}
+
+// Token range [t0, t1) of a superblock within its run (run-relative; the
+// caller adds the run's start): chunk units from the run start, the last one
+// possibly short.  Superblock ends are therefore always chunk ends, so
+// running a run superblock by superblock issues the same chunks in the same
+// order as one run - bit-identical, with checkpoints firing at the same
+// positions (plan_superblocks only ends superblocks at firings).
+inline std::pair<int64_t, int64_t> sb_token_range(Superblock sb, int64_t n, int64_t chunk_T) {
+    if (chunk_T <= 0 || n <= 0) return {0, 0};
+    const int64_t t0 = sb.c0 * chunk_T < n ? sb.c0 * chunk_T : n;
+    const int64_t t1 = sb.c1 * chunk_T < n ? sb.c1 * chunk_T : n;
+    return {t0, t1};
+}
+
+// STRATA_PREFILL_LAYER_MAJOR=1 enables the prototype path (default off: the
+// chunk-major path runs byte-identically to before).
+bool enabled();
+
+// STRATA_PREFILL_LM_MAX_TOKENS: staging fit cap in prompt tokens (default 32768:
+// the whole 32K prompt spills 32768*10240*4 = 1.31 GiB of pinned host RAM).
+int64_t max_sb_tokens();
+
+// ---- C28 layer-major execution model (pure CPU: no CUDA, no model, no GPU) ----
+//
+// The engine (Prefill::run_impl, single stage) runs a superblock wave by wave:
+// wave wl covers layer wl for every chunk, then wl+1. Between waves each
+// chunk's rows must survive: the FP32 residual R (T*D) plus the F-2 fused
+// norm carry (grs T*HC FP32, xn16 T*D BF16, xn16_lo when present). Spilling
+// them to pinned host RAM (plain byte copies, the same mechanism as the
+// layer-split hand-off) keeps every kernel's inputs bit-identical: the same
+// kernels run in the same per-(layer, chunk) order with the same T, so no
+// reduction ever runs in another order (see ENTREGA C28: kernel-by-kernel
+// enumeration). The expert stream plan (one seq for the whole run) is then
+// issued once per wave instead of once per chunk: the PCIe byte saving.
+
+// Pinned-host spill sizes for a run of n tokens (D = kHyperDim, HC = 4).
+struct SpillPlan {
+    int64_t tokens = 0;
+    uint64_t r_bytes = 0;       // tokens * D * 4 (FP32 residual rows)
+    uint64_t grs_bytes = 0;     // tokens * HC * 4 (fused norm row scales)
+    uint64_t xn16_bytes = 0;    // tokens * D * 2 (fused norm BF16 rows)
+    uint64_t total_bytes = 0;   // r + grs + xn16 (+ lo part below)
+    uint64_t lo_bytes = 0;      // tokens * D * 2 when the BF16-low carry exists
+};
+// with_lo: the bf16x2_hc() configuration carries xn16_lo too.
+SpillPlan spill_plan(int64_t n, bool with_lo);
+
+// Row stride (elements) of the spill: uniform chunks, so chunk c0 starts at
+// c0 * row_elems even when the last chunk is short (same layout as hand_in_).
+inline uint64_t spill_off_elems(int64_t c0, int64_t row_elems) {
+    return (uint64_t) c0 * (uint64_t) row_elems;
+}
+
+// Non-resident expert count per layer over [lb, le): entries with no VRAM
+// slot (host_res null, cache null, or slot < 0). The streamed walk issues
+// exactly these entries per wave, so this is the per-wave issue count the
+// engine compares against its ring slots for single-cohort eligibility.
+std::vector<int64_t> nonresident_per_layer(const int32_t* host_res, int64_t n_layers,
+                                           int64_t n_expert, int64_t lb, int64_t le);
+
+// Byte accountancy of one run (all waves): chunk-major issues every wave's
+// entries once per chunk; layer-major once per run. wave_bytes = sum over
+// waves of (entries * blob bytes); the blobs differ per layer, so the caller
+// sums them. Counting only: never feeds numerics.
+inline uint64_t stream_bytes_old(uint64_t wave_bytes_sum, int64_t chunks) {
+    return wave_bytes_sum * (uint64_t) (chunks > 0 ? chunks : 0);
+}
+inline uint64_t stream_bytes_lm(uint64_t wave_bytes_sum) { return wave_bytes_sum; }
+
+// ---- C28p: préstamo de huecos de decode (loan) para R+KV + anillo extra ----
+//
+// El camino por capas no se activaba nunca porque cada ola trae ~512
+// no-residentes y el ring es de 384 (`ring-o-stream`). Decisión del dueño:
+// PRÉSTAMO (no subir RING): durante el prefill, R+KV toman prestados huecos
+// de la caché de expertos de decode y se REPOBLAN al acabar (el refill ya
+// existente en generate.cpp). Todo lo de aquí es CPU puro (planificación y
+// contabilidad); el motor (prefill.cpp) lo usa solo con el flag on, y
+// generate.cpp presta/repuebla. Off: sin cambios (N15).
+//
+// Números: BLOB Q2_0 = 1.382.400 B. R @86K = 86016*10240*4 = 3.523.215.360 B
+// = ~2.548 slots ≈ ~2.600 huecos (~6 capas de 512 expertos por ola, 6*512 =
+// 3.072 menos el ring 384 = 2.688; con algunos residentes ≈ 2.600). @32K R =
+// 1.342.177.280 B ≈ 971 slots; con carry (grs+xn16) ≈ 1.456 slots.
+
+// Capas por ola del préstamo (default 6; STRATA_PREFILL_LM_WAVE_LAYERS).
+int64_t wave_layers();
+
+// Bytes VRAM del préstamo para el spill device de n tokens (R+carry FP32/BF16,
+// mismo spill_plan; en VRAM prestada en vez de RAM fijada).
+uint64_t loan_bytes_for_spill(int64_t n, bool with_lo);
+
+// Slots de caché necesarios para ese préstamo (techo(bytes/blob)).
+int64_t loan_slots_for_spill(int64_t n, bool with_lo, int64_t blob_bytes);
+
+// Cohortes necesarias si e_nr no cabe en el ring (techo(e_nr/ring), mín 1).
+inline int64_t cohorts_needed(int64_t e_nr, int64_t ring) {
+    if (ring <= 0 || e_nr <= 0) return 1;
+    return (e_nr + ring - 1) / ring;
+}
+
+// Slots extra de anillo que el préstamo debe aportar (0 si cabe).
+inline int64_t extra_ring_slots(int64_t max_nr, int64_t ring) {
+    return max_nr > ring ? max_nr - ring : 0;
+}
+
+// true si la ola cabe con el préstamo (anillo + slots prestados).
+inline bool wave_fits_with_loan(int64_t e_nr, int64_t ring, int64_t loan_extra_slots) {
+    return e_nr <= ring + loan_extra_slots;
+}
+
+// Olas como rangos [w0,w1) de capas (agrupadas de wave_layers en wave_layers).
+std::vector<std::pair<int64_t, int64_t>> plan_waves(int64_t lb, int64_t le, int64_t wave_layers);
+
+}  // namespace strata::prefill::layer_major
