 namespace {
@@ -955,6 +962,13 @@ bool Prefill::relayout(int64_t chunk, void* borrow, uint64_t borrow_bytes, std::
 
 int64_t Prefill::chunk() const { return impl_->T; }
 
+bool Prefill::set_lm_loan(void* base, uint64_t bytes) {
+    Impl& m = *impl_;
+    m.lm_loan_base = base;
