+}
+
 bool Prefill::draft_kv(core::MtpDrafter& mtp, const float* R_rows, const int32_t* next_tokens, int64_t n, int64_t cell0,
                        std::string& err) {
     Impl& m = *impl_;
@@ -1615,12 +1629,225 @@ bool Prefill::run_impl(const int64_t* tokens, int64_t n, int64_t pos0, std::stri
     std::future<bool> ple_next;             // declared after everything it reads: an early return waits for it
     int ple_buf = 0;
 
+    // C28 layer-major (STRATA_PREFILL_LAYER_MAJOR=1): waves outer, chunks inner.
+    // One stream plan (seq) for the whole run, issued once per wave and retained
+    // across the wave's chunks; R plus the F-2 norm carry spilled to pinned host
+    // between waves. Off: lm stays false and every guard below evaluates to
+    // today's statement (no new log lines, no behavior change).
+    struct StreamEntry { int32_t l, e; const uint8_t* blob; int job; };
+    std::vector<StreamEntry> seq;
+    std::vector<size_t> seq_start;
+    size_t issued = 0, consumed = 0;
+    const strata::kernels::cpu::ExpertLayout& lay0 = strata::kernels::cpu::expert_layout();
+    int lm_ring = m.ring;   // C28p: anillo efectivo (m.ring + slots prestados); off: == m.ring.
+    auto issue_until = [&](size_t limit) {
+        limit = std::min(limit, seq.size());
+        while (issued < limit) {
+            const StreamEntry& en = seq[issued];
+            const int sl = (int) (issued % (size_t) lm_ring);
+            const auto th = Clock::now();
+            const size_t bytes = (size_t) lay0.blob_bytes(en.l);
+            if (m.stage_live[sl]) cudaStreamWaitEvent(m.copy, m.used[m.used_of[sl]], 0);
+            if (en.job < 0) {
+                cudaMemcpyAsync(m.stage_dev[sl], en.blob, bytes, cudaMemcpyHostToDevice, m.copy);
+                ++stats_.experts_dma;
+            } else {
+                const uint8_t* hb = m.stager->wait(en.job);
+                cudaMemcpyAsync(m.stage_dev[sl], hb, bytes, cudaMemcpyHostToDevice, m.copy);
+                m.stager->issued_one(en.job, m.copy);
+            }
+            cudaEventRecord(m.copied[sl], m.copy);
+            m.stage_live[sl] = true;
+            stats_.ms_experts_host += ms_since(th);
+            ++stats_.experts_streamed;
+            stats_.experts_bytes += (uint64_t) bytes;   // C28: same event, in bytes
+            ++issued;
+        }
+    };
+    struct LmSpill {   // C28: pinned R + F-2 carry, freed at run end (also on early returns)
+        float* R = nullptr;
+        float* grs = nullptr;
+        uint16_t* xn16 = nullptr;
+        uint16_t* xn16_lo = nullptr;
+        ~LmSpill() {
+            if (R) cudaFreeHost(R);
+            if (grs) cudaFreeHost(grs);
+            if (xn16) cudaFreeHost(xn16);
+            if (xn16_lo) cudaFreeHost(xn16_lo);
+        }
+    } lm_spill;
+    // C28p: spill en huecos prestados (device, D2D sin PCIe host). Punteros tallados
+    // del préstamo por run; null = spill a RAM fijada (C28d). Solo con flag on.
+    float *lmRd = nullptr, *lmGd = nullptr;
+    uint16_t *lmXd = nullptr, *lmXld = nullptr;
+    bool lm_device_spill = false;
+    int lm_extra = 0;   // slots extra de anillo prestados (max_nr - ring, 0 si cabe)
+    struct LmStagerDone {   // C28: the run-scoped stager finish (the chunk one stays for the old path)
+        Stager* st;
