+/// **`lpids=a,b,c` (una clave por peticion, `--serve`).**  La misma fila, pero en vez
+/// del top-k imprime EXACTAMENTE esos ids.  Hace falta para System One: si la letra de
+/// una opcion no cae en el top-k, normalizar sobre las encontradas la trata como 0 y
+/// deforma la distribucion.  Con los ids exactos de las opciones no puede faltar
+/// ninguna.  Desconocida para un motor viejo (las claves se saltan), asi que es
+/// compatible hacia atras.
+void emit_logprobs_ids(const float* row, int64_t n_vocab, const std::vector<int>& ids) {
+    if (row == nullptr || n_vocab <= 0 || ids.empty()) return;
+    double mx = -1e30;
+    for (int64_t i = 0; i < n_vocab; ++i) if ((double) row[i] > mx) mx = (double) row[i];
+    double se = 0.0;
+    for (int64_t i = 0; i < n_vocab; ++i) se += std::exp((double) row[i] - mx);
+    const double lse = mx + std::log(se);
+    std::printf("strata logprobs:");
+    for (int id : ids)
+        if (id >= 0 && (int64_t) id < n_vocab) std::printf(" %d:%.6f", id, (double) row[id] - lse);
+    std::printf("\n");
+    std::fflush(stdout);
+}
+
 // ---- --serve's conversation cache.  A chat or an agent sends the whole conversation again with every request, and
