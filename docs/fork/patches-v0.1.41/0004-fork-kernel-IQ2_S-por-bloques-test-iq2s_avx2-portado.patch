+            if (iq2s_block_on()) { gu_rows_nt<22>(nt, blob, gu_row, up_off, n, act, ff, r0, r1); break; }
+            gu_rows_nt<G ? 122 : 22>(nt, blob, gu_row, up_off, n, act, ff, r0, r1); break;
         case 23: gu_rows_nt<23>(nt, blob, gu_row, up_off, n, act, ff, r0, r1); break;
